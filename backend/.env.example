# ---------------------------------------------------------------------------
# TankerLink backend — copy to .env and fill in. NEVER commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (for correct client IPs / rate limiting)
TRUST_PROXY=1

# PostgreSQL. For local dev: `npm run db:local` then use the URL below.
DATABASE_URL=postgresql://ttms:ttms@localhost:54329/ttms?schema=public

# Secrets — each at least 32 chars and all different
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HASH_SECRET=
JWT_ISSUER=ttms-auth
JWT_AUDIENCE=ttms

# Durations accept s/m/h/d suffixes
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
VERIFICATION_TOKEN_EXPIRY=15m

# OTP
OTP_LENGTH=6
OTP_EXPIRY=5m
OTP_RESEND_COOLDOWN=45s
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
# mock (DEVELOPMENT ONLY — rejected when NODE_ENV=production) | msg91 | twilio
OTP_PROVIDER=mock
# msg91: authkey | twilio: auth token
SMS_API_KEY=
# msg91: optional sender id | twilio: From number or Messaging Service SID (MG...)
SMS_SENDER_ID=
# msg91 only: DLT-approved flow template id with variables ##otp## and ##minutes##
SMS_TEMPLATE_ID=
# twilio only
TWILIO_ACCOUNT_SID=

# Email: mock (development only) | smtp
EMAIL_PROVIDER=mock
EMAIL_FROM=TTMS <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Require email OTP verification at signup when an email is supplied
EMAIL_VERIFICATION_REQUIRED=false

# Brute-force protection
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_DURATION=15m
RATE_LIMIT_ENABLED=true

# Comma-separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000
# Must be true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Session length when "Remember me" is not ticked (browser-session cookies)
SHORT_SESSION_EXPIRY=12h

# ---------------------------------------------------------------------------
# Release scope
# ---------------------------------------------------------------------------
# Comma list of: company, admin, transporter, driver. "all" = every role with legacy screens (tests only).
ENABLED_PORTALS=company,admin,transporter,driver,employee
# Demo simulator endpoints (/api/v1/demo/*): demo transporter offers, trip progression, verification.
# Development/demo environments only. Never enable for real customers.
DEMO_MODE=true
# Development only: show mock OTP codes in the UI (requires OTP_PROVIDER=mock; rejected in production)
OTP_DEV_ECHO=true

# ---------------------------------------------------------------------------
# Maps — Google Maps Platform (server key: Places API (New), Routes API, Geocoding API)
# Restrict this key by IP address in Google Cloud. It is NEVER sent to browsers.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_SERVER_KEY=
# Without a Google key: osm = OSRM road routing + Photon geocoding (development only, still road distance)
MAPS_FALLBACK_PROVIDER=osm
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io
MAPS_USER_AGENT=TankerLink/1.0 (development)

# ---------------------------------------------------------------------------
# Payments — Razorpay (use rzp_test_ keys until live settlement is enabled)
# ---------------------------------------------------------------------------
# mock = development gateway simulator (rejected in production) | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# File storage (KYC documents, support attachments, trip documents)
# ---------------------------------------------------------------------------
# Transporter portal
# 32+ chars. Encrypts bank account numbers at rest. Required in production.
FIELD_ENCRYPTION_KEY=
# 24+ chars. Enables POST /api/v1/gps/ingest for GPS hardware (X-GPS-Key header). Empty = disabled.
GPS_INGEST_KEY=

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
