  REFINERY
  PETROL_PUMP_DEALER
  INDUSTRIAL_CONSUMER
  LOGISTICS_PROVIDER
  OTHER
}

enum AddressType {
  REGISTERED
  BILLING
}

enum CompanyDocumentType {
  GST_CERTIFICATE
  PAN_CARD
  REGISTRATION_CERTIFICATE
  OTHER
}

enum DocumentReviewStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum LocationType {
  FACTORY
  OIL_DEPOT
  WAREHOUSE
  REFINERY
  PETROL_PUMP
  DELIVERY_POINT
  OTHER
}

enum BookingStatus {
  SEARCHING
