  version            Int                 @default(1)
  updatedById        String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("notification_templates")
}

model NotificationBroadcast {
  id         String   @id @default(uuid()) @db.Uuid
  title      String   @db.VarChar(160)
  message    String   @db.VarChar(500)
  audience   String   @db.VarChar(30) // ALL_COMPANIES | VERIFIED_COMPANIES | SELECTED_COMPANIES | EMPLOYEES
  channels   String[] @default([])
  recipients Int      @default(0)
  sentById   String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@map("notification_broadcasts")
}

// ===========================================================================
// SECTION 4 - TRANSPORTER PORTAL (additions; everything else reuses Sections 1-3)
// ===========================================================================

model TransporterContact {
  id            String   @id @default(uuid()) @db.Uuid
  transporterId String   @db.Uuid
  name          String   @db.VarChar(120)
  designation   String?  @db.VarChar(80)
  phone         String   @db.VarChar(15)
  email         String?  @db.VarChar(254)
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transporter Agency @relation(fields: [transporterId], references: [id], onDelete: Cascade)

  @@index([transporterId])
  @@map("transporter_contacts")
}

/// Payout account. Changes never edit a row: a new row is added and the old one superseded, for audit.
model TransporterBankAccount {
  id               String   @id @default(uuid()) @db.Uuid
  transporterId    String   @db.Uuid
  accountHolder    String   @db.VarChar(120)
  bankName         String   @db.VarChar(120)
  accountNumberEnc String   @db.VarChar(200) // AES-256-GCM; never returned to clients
  accountLast4     String   @db.Char(4)
  ifsc             String   @db.Char(11)
  accountType      String   @db.VarChar(15) // SAVINGS | CURRENT
  status           String   @default("PENDING_REVIEW") @db.VarChar(15) // PENDING_REVIEW | VERIFIED | REJECTED
  isCurrent        Boolean  @default(true)
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())

  transporter Agency @relation(fields: [transporterId], references: [id], onDelete: Restrict)

  @@index([transporterId, isCurrent])
  @@map("transporter_bank_accounts")
}

model TankerCompartment {
  id         String  @id @default(uuid()) @db.Uuid
  tankerId   String  @db.Uuid
  position   Int
  capacityKl Decimal @db.Decimal(6, 2)

  tanker Tanker @relation(fields: [tankerId], references: [id], onDelete: Cascade)

  @@unique([tankerId, position])
  @@map("tanker_compartments")
}

/// Date ranges a tanker cannot take work (blocked or under maintenance).
model TankerAvailability {
  id          String    @id @default(uuid()) @db.Uuid
  tankerId    String    @db.Uuid
  kind        String    @db.VarChar(12) // BLOCKED | MAINTENANCE
  startAt     DateTime
  endAt       DateTime
  note        String?   @db.VarChar(300)
  createdById String?   @db.Uuid
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  tanker Tanker @relation(fields: [tankerId], references: [id], onDelete: Cascade)

  @@index([tankerId, startAt])
  @@map("tanker_availability")
}

/// "Ignore booking": hides a marketplace booking from one transporter.
model BookingIgnore {
  bookingId     String   @db.Uuid
  transporterId String   @db.Uuid
  createdAt     DateTime @default(now())

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transporter Agency  @relation(fields: [transporterId], references: [id], onDelete: Cascade)

  @@id([bookingId, transporterId])
  @@map("booking_ignores")
}

// ===========================================================================
// SECTION 5 - EMPLOYEE PORTAL (additions; identity, roles, leads, KPIs reuse Section 3)
// ===========================================================================

model LeadDocument {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @db.Uuid
  title        String   @db.VarChar(120)
  fileName     String   @db.VarChar(200)
  storageKey   String   @unique @db.VarChar(200)
  mimeType     String   @db.VarChar(80)
  sizeBytes    Int
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_documents")
}

model EmployeeTaskActivity {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @db.Uuid
  type       String   @db.VarChar(15) // CREATED | STATUS | TRANSFER | REMARK | ATTACHMENT
  message    String?  @db.VarChar(1000)
  fromValue  String?  @db.VarChar(40)
  toValue    String?  @db.VarChar(40)
  fileName   String?  @db.VarChar(200)
  storageKey String?  @unique @db.VarChar(200)
  mimeType   String?  @db.VarChar(80)
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  task EmployeeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("employee_task_activities")
}

model EmployeeAttendance {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @db.Uuid
  date             DateTime  @db.Date // India working day
  checkInAt        DateTime?
  checkOutAt       DateTime?
  breakMinutes     Int       @default(0)
  breakStartedAt   DateTime?
  workingMinutes   Int?
  status           String    @default("PRESENT") @db.VarChar(15) // PRESENT | LATE | HALF_DAY | ABSENT | WEEKLY_OFF | HOLIDAY | ON_LEAVE
  earlyDeparture   Boolean   @default(false)
  checkInLatitude  Decimal?  @db.Decimal(9, 6) // only with the employee's explicit consent
  checkInLongitude Decimal?  @db.Decimal(9, 6)
  locationConsent  Boolean   @default(false)
  remarks          String?   @db.VarChar(300)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  events   AttendanceEvent[]

  @@unique([employeeId, date])
  @@index([date, status])
  @@map("employee_attendance")
}

model AttendanceEvent {
  id           String   @id @default(uuid()) @db.Uuid
  attendanceId String   @db.Uuid
  type         String   @db.VarChar(12) // CHECK_IN | CHECK_OUT | BREAK_START | BREAK_END
  at           DateTime @default(now())

  attendance EmployeeAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId, at])
  @@map("attendance_events")
}

/// Admin-configurable yearly entitlement per leave type.
model LeavePolicy {
  code        String  @id @db.VarChar(20) // CASUAL | EARNED | SICK | OTHER
  name        String  @db.VarChar(60)
  daysPerYear Decimal @db.Decimal(5, 1)
  isActive    Boolean @default(true)

  @@map("leave_policies")
}

model LeaveBalance {
  id         String  @id @default(uuid()) @db.Uuid
  employeeId String  @db.Uuid
  leaveType  String  @db.VarChar(20)
  year       Int
  entitled   Decimal @db.Decimal(5, 1)
  used       Decimal @default(0) @db.Decimal(5, 1)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType, year])
  @@map("leave_balances")
}

model LeaveApplication {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @db.Uuid
  leaveType    String    @db.VarChar(20)
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  days         Decimal   @db.Decimal(5, 1)
  reason       String    @db.VarChar(500)
  status       String    @default("PENDING") @db.VarChar(10) // PENDING | APPROVED | REJECTED | CANCELLED
  fileName     String?   @db.VarChar(200)
  storageKey   String?   @unique @db.VarChar(200)
  mimeType     String?   @db.VarChar(80)
  decidedById  String?   @db.Uuid
  decisionNote String?   @db.VarChar(300)
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@index([status, startDate])
  @@map("leave_applications")
}

/// One report per employee per working day. Corrections go through MisReportRevision.
model DailyMisReport {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @db.Uuid
  date        DateTime @db.Date
  reportType  String   @db.VarChar(15) // SALES | OPERATIONS | VERIFICATION | ACCOUNTS | GENERAL
  data        Json
  revision    Int      @default(0)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  revisions MisReportRevision[]

  @@unique([employeeId, date])
  @@index([date])
  @@map("daily_mis_reports")
}

model MisReportRevision {
  id         String   @id @default(uuid()) @db.Uuid
  reportId   String   @db.Uuid
  revision   Int
  previous   Json
  reason     String   @db.VarChar(300)
  editedById String?  @db.Uuid
  createdAt  DateTime @default(now())

  report DailyMisReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, revision])
  @@map("mis_report_revisions")
}
