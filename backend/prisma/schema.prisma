// TankerLink - Oil Tanker Booking & Logistics Marketplace.
//
// Section 1 (identity, tenancy, sessions, audit) is the original authentication core and keeps its
// original table names. Section 2 (company portal & marketplace) uses snake_case table names.
//
// Domain mapping:
//   users        -> "User"           (all human accounts, every role)
//   transporters -> "Agency"         (a transporter company; AGENCY_* roles are transporter staff)
//   drivers      -> "Driver"         (sub-login under a transporter)
//   companies    -> companies        (customer companies booking tankers - the Phase 1 portal)
//
// Conventions: UTC timestamps (displayed in Asia/Kolkata by clients), Decimal for money,
// latitude/longitude stored as separate Decimal(9,6) columns, financial rows are never deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  AGENCY_OWNER
  AGENCY_MANAGER
  DISPATCHER
  FINANCE_MANAGER
  DRIVER
  CUSTOMER
  COMPANY_ADMIN // owner/administrator of a customer company (Phase 1 portal)
  COMPANY_USER // additional company staff (future)
  EMPLOYEE // platform employee (future back-office portal)
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgencyMemberStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum LicenceType {
  LMV
  HMV
  HGMV
  HTV
  TRANS
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PHONE_CHANGE
  EMAIL_CHANGE
  ADMIN_2FA
  BANK_CHANGE
}

enum ClientType {
  WEB
  MOBILE
}

enum AuthEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESHED
  REFRESH_TOKEN_REUSE
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  REGISTERED
}

enum LoginMethod {
  PASSWORD
  OTP
  REFRESH
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  fullName            String        @db.VarChar(120)
  email               String?       @unique @db.VarChar(254) // stored lower-cased
  phone               String        @unique @db.VarChar(15) // stored as 10-digit Indian mobile number
  passwordHash        String?
  isEmailVerified     Boolean       @default(false)
  isPhoneVerified     Boolean       @default(false)
  accountStatus       AccountStatus @default(PENDING_VERIFICATION)
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  roles            UserRole[]
  memberships      AgencyMember[]
  ownedAgency      Agency?            @relation("AgencyOwner")
  driver           Driver?
  customer         Customer?
  sessions         RefreshSession[]
  loginAudits      LoginAudit[]
  invitationsMade  AgencyInvitation[] @relation("InvitationCreator")
  agenciesVerified Agency[]           @relation("AgencyVerifier")

  companyMembership      CompanyMember?
  employee               Employee?
  notifications          Notification[]
  notificationPreference NotificationPreference?
  bookingsCreated        Booking[]               @relation("BookingCreator")
  documentsUploaded      CompanyDocument[]       @relation("DocumentUploader")
  ticketsCreated         SupportTicket[]         @relation("TicketCreator")
  paymentsInitiated      Payment[]               @relation("PaymentInitiator")
  auditLogs              AuditLog[]

  @@index([accountStatus])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  description String?
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id                String                       @id @default(uuid()) @db.Uuid
  key               String                       @unique @db.VarChar(80) // e.g. "agency:members:manage"
  description       String?
  createdAt         DateTime                     @default(now())
  roles             RolePermission[]
  employeeRoles     EmployeeRolePermission[]
  employeeOverrides EmployeePermissionOverride[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Agency {
  id                     String              @id @default(uuid()) @db.Uuid
  companyName            String              @db.VarChar(160)
  ownerId                String              @unique @db.Uuid
  gstNumber              String?             @unique @db.VarChar(15)
  panNumber              String              @unique @db.VarChar(10)
  address                String              @db.VarChar(300)
  city                   String              @db.VarChar(80)
  state                  String              @db.VarChar(80)
  pincode                String              @db.Char(6)
  verificationStatus     VerificationStatus  @default(PENDING_VERIFICATION)
  rejectionReason        String?             @db.VarChar(500)
  verifiedAt             DateTime?
  verifiedById           String?             @db.Uuid
  termsAcceptedAt        DateTime
  // Marketplace profile (transporter)
  rating                 Decimal             @default(0) @db.Decimal(2, 1)
  completedTrips         Int                 @default(0)
  serviceStates          String[]            @default([])
  isDemo                 Boolean             @default(false) // seeded demo transporter - never a real business
  category               String?             @db.VarChar(40) // transporter category used by commission rules
  statusBeforeSuspension VerificationStatus?
  suspensionReason       String?             @db.VarChar(500)
  createdById            String?             @db.Uuid // admin/employee who registered it (compatible with future self-login)
  transporterCode        String              @unique @default(dbgenerated("('TRP'::text || lpad((nextval('transporter_code_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(12)
  businessType           String?             @db.VarChar(40)
  operationalAddress     String?             @db.VarChar(300)
  operatingCities        String[]            @default([])
  preferredRoutes        String[]            @default([])
  declaredTankers        Int?
  capacityCategories     String[]            @default([])
  productCategories      String[]            @default([]) // Product.code values
  bookingAlertPrefs      Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  owner           User                       @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  verifiedBy      User?                      @relation("AgencyVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  members         AgencyMember[]
  drivers         Driver[]
  invitations     AgencyInvitation[]
  tankers         Tanker[]
  offers          TransporterOffer[]
  allocations     BookingAllocation[]
  trips           Trip[]
  settlements     Settlement[]
  driverHistory   DriverTransporterHistory[]
  contacts        TransporterContact[]
  bankAccounts    TransporterBankAccount[]
  tickets         SupportTicket[]
  ignoredBookings BookingIgnore[]

  @@index([verificationStatus])
}

model AgencyMember {
  id        String             @id @default(uuid()) @db.Uuid
  agencyId  String             @db.Uuid
  userId    String             @db.Uuid
  role      RoleName // role the user holds inside this agency
  status    AgencyMemberStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user belongs to at most one agency (single-tenant membership).
  @@unique([userId])
  @@index([agencyId, role])
}

model AgencyInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  agencyId    String    @db.Uuid
  codeHash    String    @unique // HMAC of the invitation code; raw code is shown once
  codeHint    String    @db.VarChar(8) // last characters, for display only
  role        RoleName  @default(DRIVER)
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model Driver {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @unique @db.Uuid
  agencyId                String             @db.Uuid
  licenceNumber           String             @unique @db.VarChar(20)
  licenceType             LicenceType
  licenceExpiry           DateTime           @db.Date
  verificationStatus      VerificationStatus @default(PENDING_VERIFICATION)
  isDemo                  Boolean            @default(false)
  hazardousTraining       HazardousTraining  @default(NOT_PROVIDED)
  hazardousTrainingExpiry DateTime?          @db.Date
  rejectionReason         String?            @db.VarChar(500)
  address                 String?            @db.VarChar(300)
  emergencyContactName    String?            @db.VarChar(120)
  emergencyContactPhone   String?            @db.VarChar(15)
  employmentStatus        EmploymentStatus   @default(ACTIVE)
  isActive                Boolean            @default(true)
  invitedAt               DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency         Agency                     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  trips          Trip[]
  assignedTanker Tanker?                    @relation("TankerDriver")
  history        DriverTransporterHistory[]

  @@index([agencyId, verificationStatus])
}

model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @db.Uuid
  customerType CustomerType
  businessName String?      @db.VarChar(160)
  gstNumber    String?      @db.VarChar(15)
  city         String?      @db.VarChar(80)
  state        String?      @db.VarChar(80)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Verification, sessions & audit
// ---------------------------------------------------------------------------

model OTPVerification {
  id          String     @id @default(uuid()) @db.Uuid
  destination String     @db.VarChar(254) // normalised phone or lower-cased email
  channel     OtpChannel
  purpose     OtpPurpose
  otpHash     String // HMAC-SHA256 of the code; raw codes are never stored
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int
  verifiedAt  DateTime? // code was entered correctly
  consumedAt  DateTime? // the verification was used (registration, login, reset)
  invalidated Boolean    @default(false) // superseded by a newer code or locked out
  ipAddress   String?    @db.VarChar(64)
  createdAt   DateTime   @default(now())

  @@index([destination, purpose, createdAt])
}

model RefreshSession {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  familyId      String     @db.Uuid // all rotations of one login share a family
  tokenHash     String     @unique
  clientType    ClientType
  persistent    Boolean    @default(true) // "Remember me": false = browser-session cookies + short expiry
  deviceInfo    String?    @db.VarChar(200)
  ipAddress     String?    @db.VarChar(64)
  userAgent     String?    @db.VarChar(300)
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?    @db.VarChar(40)
  replacedById  String?    @db.Uuid
  lastUsedAt    DateTime?
  createdAt     DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

model LoginAudit {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String?      @db.Uuid
  identifier    String?      @db.VarChar(254)
  event         AuthEvent
  method        LoginMethod?
  success       Boolean
  failureReason String?      @db.VarChar(80)
  clientType    ClientType?
  ipAddress     String?      @db.VarChar(64)
  userAgent     String?      @db.VarChar(300)
  createdAt     DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([identifier, createdAt])
}

// ===========================================================================
// SECTION 2 - COMPANY PORTAL & MARKETPLACE
// ===========================================================================

