# Base URL of the TTMS auth backend (no trailing slash).
# Android emulator: http://10.0.2.2:4000  ·  iOS simulator: http://localhost:4000  ·  Device: http://<your-LAN-IP>:4000
# Production must use HTTPS.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Web app URL, used for the "register" and "pay online" links that open in the browser.
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3000
