# Base URL of the TankerLink backend. Used by the /api/v1 rewrite proxy and by server-side session checks.
# The browser itself always calls /api/v1 on this web origin so auth cookies stay first-party.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: internal URL for server-to-server calls. Defaults to NEXT_PUBLIC_API_URL.
API_URL=

# Google Maps JavaScript API *browser* key (public by design). Restrict it in Google Cloud to your
# site's HTTP referrers and to the Maps JavaScript API only. Leave empty to use the OpenStreetMap
# development map. The *server* key for Places/Routes lives only in backend/.env.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Comma list of released web portals: company, transporter, driver, employee. "all" re-enables legacy screens.
NEXT_PUBLIC_ENABLED_PORTALS=company,transporter,driver,employee
# Realtime gateway. Defaults to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SOCKET_URL=
